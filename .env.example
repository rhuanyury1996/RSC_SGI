DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local: POSTGRES_* | Render: DATABASE_URL (automático ao vincular o Postgres)
POSTGRES_DB=sgi_rsc
POSTGRES_USER=sgi_rsc
POSTGRES_PASSWORD=sgi_rsc_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/dbname

CEO_USERNAME=rfloriano
CEO_PASSWORD=

# Google Calendar OAuth (Console Cloud → APIs → Credenciais → OAuth cliente Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/calendario/google/callback/
# Fluxo Gmail do CRM (independente do calendário)
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/comercial/gmail/callback/

# Webhook / OAuth Gmail → card RSC Pré-vendas (Prospecções)
CRM_GMAIL_WEBHOOK_TOKEN=
CRM_GMAIL_ASSUNTO_GATILHO=RSC: Agenda de final do ano CAPEX
CRM_GMAIL_LABEL=Oportunidades/Quentes
CRM_PROSPECCAO_CLIENTE_RSC=RSC
